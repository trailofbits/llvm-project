# A true D8 output only protects its low 64 bits. A true Q8 output protects
# both halves. The frozen original interface predates PEI's liveness operands.
# PLAN-DAG: !"aarch64.zero-call-used-regs", !"{{[0-9A-F]+}}", !"FF", !"{{[0-9A-F]+}}", !"0", !"return"
# PLAN-DAG: !"aarch64.zero-call-used-regs", !"{{[0-9A-F]+}}", !"FE", !"{{[0-9A-F]+}}", !"1", !"return"
# UPPER: AArch64 zeroization verifier: V8[127:64] is not proven zero at return in bb.2
# JOIN: AArch64 zeroization verifier: V8[127:64] is not proven zero at return in bb.4
# FP: AArch64 zeroization verifier: V9[127:64] is not proven zero at return
# PLAN-ERROR: AArch64 zeroization verifier: register obligation disagrees with eligible units and exit interface

#--- two.mir
--- |
  target triple = "aarch64-unknown-linux-gnu"
  define void @two() "zero-call-used-regs"="all" { ret void }
...
---
name: two
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $q8
    CBZW $w0, %bb.2
    B %bb.1
  bb.1:
    liveins: $q8
    RET undef $lr, implicit $d8
  bb.2:
    liveins: $q8
    RET undef $lr, implicit $q8
...

#--- scalar.ll
define i64 @scalar(i64 %arg) "zero-call-used-regs"="all" { ret i64 %arg }

#--- join.py
import pathlib
import sys

source = pathlib.Path(sys.argv[1]).read_text()
ret = "    RET undef $lr, !1,"
assert source.count(ret) == 1
branch = """    CBNZW $w0, %bb.4
  bb.3:
    $q8 = MOVIv2d_ns 255
  bb.4:
"""
pathlib.Path(sys.argv[2]).write_text(source.replace(ret, branch + ret))
