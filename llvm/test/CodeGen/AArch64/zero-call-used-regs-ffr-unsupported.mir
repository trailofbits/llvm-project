# RUN: split-file %s %t
# RUN: not llc -mtriple=aarch64-linux-gnu -mattr=+sve -verify-machineinstrs \
# RUN:   %t/no-scratch.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=SCRATCH
# RUN: sed 's/="all"/="used"/' %t/no-scratch.ll | \
# RUN:   not llc -mtriple=aarch64-linux-gnu -mattr=+sve -verify-machineinstrs \
# RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=SCRATCH
# RUN: not llc -mtriple=aarch64-linux-gnu -mattr=+sve,+sme -run-pass=prolog-epilog \
# RUN:   %t/streaming.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=STREAM
# RUN: sed 's/aarch64_pstate_sm_enabled/aarch64_pstate_sm_compatible/' %t/streaming.mir | \
# RUN:   not llc -x=mir -mtriple=aarch64-linux-gnu -mattr=+sve,+sme -run-pass=prolog-epilog \
# RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=STREAM
# RUN: llc -mtriple=aarch64-linux-gnu -mattr=+sve,+sme,+sme-fa64 -run-pass=prolog-epilog \
# RUN:   -verify-machineinstrs %t/streaming.mir -o - | FileCheck %s --check-prefix=FA64

# SCRATCH: error: {{.*}}"zero-call-used-regs" cannot clear FFR without overwriting a predicate needed at the exit
# STREAM: error: {{.*}}"zero-call-used-regs" cannot clear FFR in streaming mode without SME FA64
# FA64: WRFFR $p0, implicit-def $ffr

# All four caller-saved predicates carry results. P4-P15 are callee-saved
# under the SVE PCS, so clearing FFR cannot borrow a predicate safely.
#--- no-scratch.ll
%predicates = type { <vscale x 16 x i1>, <vscale x 16 x i1>, <vscale x 16 x i1>, <vscale x 16 x i1> }
declare void @llvm.aarch64.sve.setffr()
define aarch64_sve_vector_pcs %predicates @four_predicates(
    <vscale x 16 x i1> %p0, <vscale x 16 x i1> %p1,
    <vscale x 16 x i1> %p2, <vscale x 16 x i1> %p3) "zero-call-used-regs"="all" {
  call void @llvm.aarch64.sve.setffr()
  %v0 = insertvalue %predicates poison, <vscale x 16 x i1> %p0, 0
  %v1 = insertvalue %predicates %v0, <vscale x 16 x i1> %p1, 1
  %v2 = insertvalue %predicates %v1, <vscale x 16 x i1> %p2, 2
  %v3 = insertvalue %predicates %v2, <vscale x 16 x i1> %p3, 3
  ret %predicates %v3
}

; FFR is selected even without an explicit use for the all mode.
#--- streaming.mir
--- |
  define void @streaming() "aarch64_pstate_sm_enabled" "zero-call-used-regs"="all" { ret void }
...
---
name: streaming
tracksRegLiveness: true
body: |
  bb.0:
    RET_ReallyLR
...
