# RUN: llc -mtriple=aarch64-unknown-linux-gnu -run-pass=prolog-epilog -verify-machineinstrs %s -o \
# RUN: - | FileCheck %s
# CHECK-LABEL: name: debug_flags
# CHECK: DBG_VALUE
# CHECK: MSR 55824, $xzr, implicit-def $nzcv
# CHECK: RET_ReallyLR {{.*}}implicit $nzcv

--- |
  define void @debug_flags() "zeroize-flags" !dbg !4 {
    ret void, !dbg !8
  }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "test",
                              isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !{i32 2, !"Dwarf Version", i32 4}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "debug_flags", scope: !1, file: !1, line: 1, type: !5,
                             scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !6)
  !5 = !DISubroutineType(types: !6)
  !6 = !{}
  !7 = !DILocalVariable(name: "value", scope: !4, file: !1, line: 1, type: !9)
  !8 = !DILocation(line: 1, column: 1, scope: !4)
  !9 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
...
---
name: debug_flags
tracksRegLiveness: true
body: |
  bb.0:
    DBG_VALUE $w0, $noreg, !7, !DIExpression(), debug-location !8
    RET_ReallyLR
...
