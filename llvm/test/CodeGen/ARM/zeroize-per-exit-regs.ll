; THUMB2-NEXT:    mov r1, r2
; THUMB2-NEXT:    movs r2, #0
; THUMB2-NEXT:    b callee
entry:
  br i1 %c, label %tail, label %plain

tail:
  %r = tail call i32 @callee(i32 %a, i32 %b)
