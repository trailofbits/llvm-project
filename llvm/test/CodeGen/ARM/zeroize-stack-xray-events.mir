# RUN: not llc -mtriple=armv7-unknown-linux-gnueabihf -run-pass=prolog-epilog \
# RUN:   %s -o /dev/null 2>&1 | FileCheck %s

# xray-never suppresses function instrumentation, not explicit event pseudos.
# These pseudos do not establish an owned ARM frame extent.
# CHECK: error: {{.*}}in function custom {{.*}}ARM stack clearing does not support
# CHECK: error: {{.*}}in function typed {{.*}}ARM stack clearing does not support
--- |
  define void @custom() "zeroize-stack"="used" #0 { ret void }
  define void @typed() "zeroize-stack"="sensitive" #0 { ret void }
  attributes #0 = { "function-instrument"="xray-never" }
...
---
name: custom
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $lr
    PATCHABLE_EVENT_CALL $r0, $r1
    BX_RET 14, $noreg, implicit $lr
...
---
name: typed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $lr
    PATCHABLE_TYPED_EVENT_CALL $r0, $r1, $r2
    BX_RET 14, $noreg, implicit $lr
...
