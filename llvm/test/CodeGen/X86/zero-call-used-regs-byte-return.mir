# RUN: llc -mtriple=x86_64 -run-pass=prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s

# AL and AH are disjoint, but clearing either uses a full EAX write. Preserve
# the returned byte without suppressing clears of unrelated registers.
--- |
  define i8 @return_low() "zero-call-used-regs"="all-gpr" { ret i8 1 }
  define i8 @return_high() "zero-call-used-regs"="all-gpr" { ret i8 1 }
  define void @dead_high() "zero-call-used-regs"="used-gpr" { ret void }
...
---
name: return_low
tracksRegLiveness: true
body: |
  bb.0:
    $al = MOV8ri 1
    RET64 implicit $al
# CHECK-LABEL: name: return_low
# CHECK: $al = MOV8ri 1
# CHECK-NOT: $eax =
# CHECK: $ecx = XOR32rr
# CHECK-NOT: $eax =
# CHECK: RET64 implicit $al
...
---
name: return_high
tracksRegLiveness: true
body: |
  bb.0:
    $ah = MOV8ri 1
    RET64 implicit $ah
# CHECK-LABEL: name: return_high
# CHECK: $ah = MOV8ri 1
# CHECK-NOT: $eax =
# CHECK: $ecx = XOR32rr
# CHECK-NOT: $eax =
# CHECK: RET64 implicit $ah
...
---
name: dead_high
tracksRegLiveness: true
body: |
  bb.0:
    $ah = MOV8ri 1
    RET64
# CHECK-LABEL: name: dead_high
# CHECK: $ah = MOV8ri 1
# CHECK-NEXT: $eax = XOR32rr
# CHECK-NEXT: RET64
...
