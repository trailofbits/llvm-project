# RUN: llc -mtriple=x86_64 -run-pass=prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define i32 @undef_return() "zero-call-used-regs"="used-gpr" { ret i32 undef }
  define i32 @live_return() "zero-call-used-regs"="used-gpr" { ret i32 123 }
  define i8 @live_alias() "zero-call-used-regs"="used-gpr" { ret i8 123 }
...
---
name: undef_return
tracksRegLiveness: true
body: |
  bb.0:
    $eax = MOV32ri 123
    RET64 implicit undef $eax
# CHECK-LABEL: name: undef_return
# CHECK: $eax = XOR32rr
# CHECK-NEXT: RET64 implicit undef $eax
...
---
name: live_return
tracksRegLiveness: true
body: |
  bb.0:
    $eax = MOV32ri 123
    RET64 implicit $eax
# CHECK-LABEL: name: live_return
# CHECK: $eax = MOV32ri 123
# CHECK-NEXT: RET64 implicit {{(killed )?}}$eax
...
---
name: live_alias
tracksRegLiveness: true
body: |
  bb.0:
    $rax = MOV64ri 123
    RET64 implicit undef $rax, implicit $al
# CHECK-LABEL: name: live_alias
# CHECK: $rax = MOV64ri 123
# CHECK-NOT: $eax = XOR32rr
# CHECK-NOT: $al =
# CHECK: RET64 implicit undef $rax, implicit {{(killed )?}}$al
...
