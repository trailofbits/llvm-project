# RUN: not llc -mtriple=x86_64-unknown-linux-gnu -mattr=+sahf \
# RUN:   -run-pass=prolog-epilog -verify-machineinstrs %s -o /dev/null 2>&1 \
# RUN:   | FileCheck %s

# CHECK: error: {{.*}}in function live_flags
# CHECK-SAME: {{ .*}}X86 flags clearing would overwrite live condition flags
# CHECK: error: {{.*}}in function no_scratch
# CHECK-SAME: {{ .*}}X86 flags clearing needs a free caller-saved register
--- |
  define void @live_flags() "zeroize-flags" { ret void }
  define void @no_scratch() "zeroize-flags" { ret void }
...
---
name: live_flags
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $eflags
    RET64 0, implicit $eflags
...
---
name: no_scratch
tracksRegLiveness: true
# The long RET keeps all nine caller-saved GPRs live in one MIR instruction,
# preserving the scratch-exhaustion case despite the 100-column limit.
body: |
  bb.0:
    liveins: $rax, $rcx, $rdx, $rsi, $rdi, $r8, $r9, $r10, $r11
    RET64 0, implicit $rax, implicit $rcx, implicit $rdx, implicit $rsi, implicit $rdi, implicit $r8, implicit $r9, implicit $r10, implicit $r11
...
