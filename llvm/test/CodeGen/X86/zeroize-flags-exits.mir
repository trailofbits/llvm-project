# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+sahf \
# RUN:   -run-pass=prolog-epilog -verify-machineinstrs %s -o %t
# RUN: FileCheck %s < %t
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+sahf -x mir \
# RUN:   -run-pass=postmisched,dead-mi-elimination -verify-machineinstrs %t -o - \
# RUN:   | FileCheck %s

# Separate exits preserve different return registers and retain the final flags.
# CHECK-LABEL: name: different_liveouts
# CHECK: $r11d = XOR32rr
# CHECK: $rax, $r11 = frame-destroy XCHG64rr $rax, $r11
# CHECK: frame-destroy TEST32rr $eax, $eax, implicit-def $eflags
# CHECK: frame-destroy SAHF implicit-def $eflags, implicit $ah, implicit $eflags
# CHECK: $rax, $r11 = frame-destroy XCHG64rr $rax, $r11
# CHECK: RET64 0, implicit $rax, implicit $r11d, implicit $eflags
# CHECK: $eax = XOR32rr
# CHECK: frame-destroy TEST32rr $eax, $eax, implicit-def $eflags
# CHECK: frame-destroy SAHF implicit-def $eflags, implicit $ah, implicit $eflags
# CHECK: RET64 0, implicit $rdx, implicit $eax, implicit $eflags
--- |
  define void @different_liveouts() "zeroize-flags" { ret void }
...
---
name: different_liveouts
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rax, $rdx, $rdi
    TEST64rr $rdi, $rdi, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
  bb.1:
    liveins: $rax
    RET64 0, implicit $rax
  bb.2:
    liveins: $rdx
    RET64 0, implicit $rdx
...
