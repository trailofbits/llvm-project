; Splitting an inline memory intrinsic over a promoted alloca must keep the
; inline form for every piece. memset.inline and memcpy.inline guarantee that
; no external function is called, and rebuilding a piece as memset or memcpy
; would drop that guarantee.

define void @memset_inline_split() {
; CHECK-LABEL: define void @memset_inline_split() {
; CHECK-NEXT:    [[BUF_SROA_2:%.*]] = alloca [63 x i8], align 1
; CHECK-NEXT:    call void @llvm.memset.inline.p0.i64(ptr align 1 [[BUF_SROA_2]], i8 0, i64 63, i1 false)
; CHECK-NEXT:    ret void
;
  %buf = alloca [64 x i8]
  store i8 1, ptr %buf
  call void @llvm.memset.inline.p0.i64(ptr %buf, i8 0, i64 64, i1 false)
  ret void
}

